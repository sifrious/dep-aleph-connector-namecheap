{
    "name": "sifrious/aleph-connector-namecheap",
    "description": "Read-only Namecheap registrar connector for Aleph.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4.1",
        "ext-simplexml": "*",
        "sifrious/aleph": "@dev"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Sifrious\\NamecheapConnector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sifrious\\NamecheapConnector\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sifrious\\NamecheapConnector\\NamecheapServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../Funes",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "../Aleph",
            "options": { "symlink": true }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
